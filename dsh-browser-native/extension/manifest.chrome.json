{
  "manifest_version": 3,
  "name": "DSH Browser Native",
  "version": "0.1.0",
  "description": "ChatGPT-compatible browser capabilities for DSH and Codex backends.",
  "permissions": [
    "alarms", "bookmarks", "debugger", "downloads", "history", "nativeMessaging",
    "notifications", "scripting", "sessions", "storage", "tabGroups", "tabs",
    "topSites", "webNavigation", "contextMenus", "sidePanel"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "DSH Browser Native" },
  "side_panel": { "default_path": "panel/index.html" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"
  }
}
