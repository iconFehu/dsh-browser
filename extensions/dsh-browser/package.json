{
  "name": "dsh-browser-extension",
  "description": "Chrome and Firefox MV3 extension: sidebar chat with a local dsh instance and text-only read/operate of a user-controlled tab through the dsh browser bridge",
  "version": "0.1.7",
  "author": "Yuxiang Lin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --firefox",
    "dev": "node scripts/build.mjs --watch",
    "dev:firefox": "node scripts/build.mjs --firefox --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tldts": "^7.4.12"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@yuxianglin/dsh-bridge-browser": "workspace:^",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
